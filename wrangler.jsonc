{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nat-bar-nat-review",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "rashti-review.scp-study.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/*"
    ],
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "STUDY_ASSETS",
      "bucket_name": "scp-study-audio"
    }
  ],
  "build": {
    "command": "node build.mjs"
  }
}
